# Copy to ".env" and fill in. Never commit .env.

# Slack Incoming Webhook (empty = print alerts in the terminal instead)
SLACK_WEBHOOK_URL=

# LLM: "openai" or "gemini" (empty keys = skip the LLM, send plain-text alerts)
LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Rule thresholds (defaults shown)
MIN_SPEND=50
MIN_LEADS=5
MIN_IMPRESSIONS=2000
CPL_OVER_TARGET_PCT=25
CTR_DROP_PCT=30
FREQ_FATIGUE=2.8
SCALE_MIN_SPEND=150
SCALE_UNDER_TARGET_PCT=15
SCALE_MAX_FREQ=2.0
